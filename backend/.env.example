# ──────────────────────────────────────────────────────────────────────
# CodeIntel Backend Configuration — Environment Template
# NEVER commit real API keys, passwords, or credentials to Git.
# ──────────────────────────────────────────────────────────────────────

# Core Application Settings
APP_NAME=CodeIntel
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
POSTGRES_USER=codeintel
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=codeintel
DATABASE_URL=postgresql+asyncpg://codeintel:your_secure_postgres_password_here@postgres:5432/codeintel

# Redis Cache & Background Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ChromaDB Vector Database Configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# LLM & Embedding Credentials (NEVER HARDCODE IN REPO)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here

# Model Configurations
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LLM_MODEL_NAME=gpt-4o-mini
